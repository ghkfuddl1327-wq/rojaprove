# redcell — example environment variables (PLACEHOLDERS ONLY).
#
# Copy this file to .env and put REAL values there. .env is gitignored and must NEVER be
# committed. Never put real secrets in this file — .env.example IS committed.
#
# Bring-your-own-key auth for a target you own or are authorized to test:

# Bearer token sent to the target as  Authorization: Bearer <token>
REDCELL_AUTH_BEARER=

# Alternative/fallback token (used only if REDCELL_AUTH_BEARER is unset).
REDCELL_TARGET_API_KEY=
